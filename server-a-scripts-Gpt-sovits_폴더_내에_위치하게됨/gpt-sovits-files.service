[Unit]
Description=GPT-SoVITS File Scanner API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/GPT-SoVITS
ExecStart=/root/miniforge3/envs/GPTSoVits/bin/python -m uvicorn file_scanner_api:app --host 0.0.0.0 --port 10001
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
