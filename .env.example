# ==========================================
# AI-Server (.env) 예시 템플릿
# ==========================================
# 이 파일은 "AI-Server 폴더 내부에서 실행하는 명령" 기준 env 예시입니다.
#
# 포함 대상:
# - vllm-docker-compose.yml (HF_TOKEN)
# - scripts/server-a/test-vllm.sh (VLLM_URL)
# - scripts/ollama_pull_progress.py (OLLAMA_HOST)
# - server-a-scripts-Gpt-sovits_inside/test_training.py (TRAINING_* 계열)
#
# 참고:
# - repo 루트 docker-compose.yaml에서 쓰는 env(NEXT_PUBLIC_API_URL, *_OVERRIDE 등)는
#   이 파일이 아니라 "repo 루트 .env" 또는 쉘 export에 넣는 것이 맞습니다.

# ------------------------------------------
# vLLM 컨테이너 실행/모델 다운로드
# ------------------------------------------
# [조건부 필수] Hugging Face 토큰 (게이트드/인증 필요한 모델 사용 시)
# madcamp-Screening-Humanity-AI-Server/vllm-docker-compose.yml 에서 사용
HF_TOKEN=

# ------------------------------------------
# vLLM 테스트 스크립트 (scripts/server-a/test-vllm.sh)
# ------------------------------------------
# [선택] vLLM 서버 URL
# 미설정 시 기본값: http://localhost:8002
VLLM_URL=http://localhost:8002

# ------------------------------------------
# Ollama 유틸 스크립트 (scripts/ollama_pull_progress.py)
# ------------------------------------------
# [선택] Ollama 호스트 (호스트:포트 또는 http://호스트:포트)
# 미설정 시 기본값: localhost:11434
OLLAMA_HOST=localhost:11434

# ------------------------------------------
# GPT-SoVITS Training API 테스트 스크립트
# server-a-scripts-Gpt-sovits_inside/test_training.py
# ------------------------------------------
# [선택] training_api URL (기본 포트 10002)
# 미설정 시 기본값: http://localhost:10002
TRAINING_API_URL=http://localhost:10002

# [선택] dry-run 테스트용 모델명
TRAINING_TEST_MODEL_NAME=dry_run_test_01

# [선택] 학습용 업로드 경로 (dry_run=False 또는 실경로 테스트 시 중요)
# Host/Conda 예시: /opt/GPT-SoVITS/sample_train_voice/your_voice_folder
TRAINING_TEST_UPLOAD_PATH=/opt/GPT-SoVITS/ref_audio/target_voice_folder

# [선택] GPT-SoVITS 버전 라벨 (예: v2, v3 ...)
TRAINING_TEST_VERSION=v2

# ------------------------------------------
# GPT-SoVITS 자동화 API 직접 실행 시 (선택)
# ------------------------------------------
# [선택] file_scanner_api.py / training_api.py 가 GPT-SoVITS 루트를 찾을 때 사용
# Docker sidecar 기본값: /workspace/GPT-SoVITS
# Host/Conda 기본 폴백: /opt/GPT-SoVITS
GPT_SOVITS_ROOT=

# [선택] GPT-SoVITS half precision 사용 여부 (주로 Docker/학습 실행 시)
is_half=true

# [선택] Python stdout 버퍼링 비활성화 (로그 실시간 확인용)
PYTHONUNBUFFERED=1

# ==========================================
# 예시 실행
# ==========================================
# 1) vLLM 테스트
#    export VLLM_URL=http://localhost:8002
#    bash scripts/server-a/test-vllm.sh
#
# 2) Ollama pull 진행률
#    export OLLAMA_HOST=localhost:11434
#    python scripts/ollama_pull_progress.py glm-4.7-flash
#
# 3) Training API dry-run 테스트
#    export TRAINING_API_URL=http://localhost:10002
#    python server-a-scripts-Gpt-sovits_inside/test_training.py

